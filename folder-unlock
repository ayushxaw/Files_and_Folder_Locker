#!/bin/bash
# Unlock an encrypted folder (gocryptfs) or a .locked file (gpg).
# Usage: folder-unlock [path]

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
source "$SCRIPT_DIR/locker-auth"

TARGET="${1:-}"

if [ -z "$TARGET" ]; then
    TARGET=$(zenity --file-selection \
        --title="Select a file or folder to unlock" 2>/dev/null) || exit 0
fi

TARGET=$(realpath "$TARGET")
NAME=$(basename "$TARGET")

if [ -f "$TARGET" ] && [[ "$TARGET" == *.locked ]]; then
    ORIGINAL="${TARGET%.locked}"
    ORIG_NAME=$(basename "$ORIGINAL")

    _authenticate "Enter system password to unlock '$ORIG_NAME':"

    echo "$MASTER_PASS" | gpg --batch --yes --passphrase-fd 0 \
        --decrypt --output "$ORIGINAL" "$TARGET" 2>/dev/null
    unset MASTER_PASS

    if [ -f "$ORIGINAL" ]; then
        rm -f "$TARGET"
        zenity --info --title="Folder Locker" \
            --text="'$ORIG_NAME' is unlocked." --width=250 2>/dev/null &
    else
        zenity --error --title="Folder Locker" \
            --text="Could not decrypt '$ORIG_NAME'. Wrong password or corrupted file." \
            --width=320 2>/dev/null
        exit 1
    fi
    exit 0
fi

if [ -d "$TARGET" ]; then
    PARENT=$(dirname "$TARGET")
    VAULT="$PARENT/.${NAME}_vault"

    if [ ! -f "$VAULT/gocryptfs.conf" ]; then
        zenity --error --title="Folder Locker" \
            --text="'$NAME' is not an encrypted folder." --width=300 2>/dev/null
        exit 1
    fi

    if findmnt -M "$TARGET" &>/dev/null; then
        nautilus "$TARGET" &>/dev/null &
        exit 0
    fi

    _authenticate "Enter system password to unlock '$NAME':"

    mkdir -p "$TARGET"
    rm -f "$TARGET/LOCKED.txt" "$TARGET/🔒 LOCKED.txt" "$TARGET/HOW TO UNLOCK.txt"

    echo "$MASTER_PASS" | gocryptfs -q "$VAULT" "$TARGET" 2>/dev/null
    unset MASTER_PASS

    if ! findmnt -M "$TARGET" &>/dev/null; then
        zenity --error --title="Folder Locker" \
            --text="Failed to unlock '$NAME'." --width=300 2>/dev/null
        exit 1
    fi

    ICON_FILE="$HOME/.local/share/icons/custom/folder-${NAME,,}.png"
    if [ -f "$ICON_FILE" ]; then
        gio set "$TARGET" metadata::custom-icon "file://$ICON_FILE" 2>/dev/null || true
    fi

    nautilus "$TARGET" &>/dev/null &

    # Watch Nautilus and auto-lock the folder once Files closes.
    (
        sleep 5
        while true; do
            sleep 3
            if ! pgrep -x nautilus &>/dev/null; then
                "$SCRIPT_DIR/folder-lock" "$TARGET" 2>/dev/null || true
                exit 0
            fi
        done
    ) &
    disown
    exit 0
fi

zenity --error --title="Folder Locker" \
    --text="'$NAME' is not a locked file or encrypted folder." --width=300 2>/dev/null
exit 1
